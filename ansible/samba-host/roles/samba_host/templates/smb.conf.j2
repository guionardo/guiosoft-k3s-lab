[global]
   workgroup = WORKGROUP
   server role = standalone server
   security = user
   map to guest = Never
   server min protocol = SMB2_02
   smb ports = 445
   disable netbios = yes
   bind interfaces only = yes
   interfaces = lo 192.168.88.9/24
   hosts allow = 127. 192.168.88.
   hosts deny = ALL
   load printers = no
   disable spoolss = yes
{% for share in samba_shares %}
[{{ share.name }}]
   path = {{ share.path }}
   browseable = yes
   read only = {{ 'yes' if share.readonly else 'no' }}
   guest ok = no
   valid users = {{ samba_auth_users | join(' ') }}
   follow symlinks = no
   wide links = no
{% endfor %}
{% if samba_enable_immich_input %}
[FotosEntrada]
   path = {{ samba_immich_input_path }}
   browseable = yes
   read only = no
   guest ok = no
   valid users = {{ samba_auth_users | join(' ') }}
{% endif %}
