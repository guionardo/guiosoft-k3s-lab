# CANDIDATO NÃO IMPLANTADO — renderizar em arquivo temporário e validar com testparm.
# NÃO copiar para /etc/samba/smb.conf antes de aprovação e preflight de mountpoints.
[global]
    workgroup = WORKGROUP
    server role = standalone server
    security = user
    server min protocol = SMB2_02
    map to guest = Never
    usershare allow guests = no
    restrict anonymous = 2
    hosts allow = 127. 192.168.88.
    hosts deny = ALL
    follow symlinks = no
    wide links = no

{% for share in samba_shares %}
[{{ share.name }}]
    path = {{ share.path }}
    browseable = yes
    guest ok = no
    valid users = {{ samba_auth_users | join(' ') }}
    read only = {{ 'yes' if share.readonly else 'no' }}
    follow symlinks = no
    wide links = no

{% endfor %}
